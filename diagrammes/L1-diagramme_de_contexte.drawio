        <mxCell id="g1" edge="1" parent="1" source="randonneur" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=1.4;startArrow=none;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="utilenr" value="">
          <mxGeometry relative="1" as="geometry" />
