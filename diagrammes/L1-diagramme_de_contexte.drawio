        <mxCell id="utilenr" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Utilisateur enregistré&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1457D6&quot;&gt;Acteur de la figure 1 qui regroupe les rôles disposant d&#39;un compte. Le glossaire ne le définit pas.&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="414" x="446" y="407" as="geometry" />
        </mxCell>
        <mxCell id="randonneur" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Randonneur&lt;/b&gt;&lt;br&gt;Adhésion active et niveau d&#39;habileté suffisant requis pour s&#39;inscrire." vertex="1">
