        <mxCell id="lge6" edge="1" parent="1" style="edgeStyle=none;html=1;rounded=0;strokeColor=#44474A;strokeWidth=1.4;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=blockThin;endFill=1;endSize=7;align=left;verticalAlign=middle;" value="">
