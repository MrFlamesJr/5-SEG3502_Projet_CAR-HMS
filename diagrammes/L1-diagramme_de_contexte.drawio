          </mxGeometry>
        </mxCell>
        <mxCell id="lge8t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;" value="Flux ajouté par hypothèse" vertex="1">
          <mxGeometry height="22" width="430" x="138" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="lge9" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#5F6368;strokeWidth=1.4;startArrow=none;endArrow=block;endFill=0;endSize=12;" value="">
          <mxGeometry relative="1" as="geometry">
