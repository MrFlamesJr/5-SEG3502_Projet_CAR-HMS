        <mxCell id="lg3s" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F1F3;strokeColor=#8A9199;strokeWidth=1.5;fontColor=#1457D6;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;dashPattern=8 4;" value="" vertex="1">
