        </mxCell>
        <mxCell id="organisateur" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;strokeWidth=1.5;fontColor=#1A1A1A;fontSize=11;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Organisateur de randonnée&lt;/b&gt;&lt;br&gt;Certification de chef de randonnée valide et niveau d&#39;organisateur suffisant." vertex="1">
