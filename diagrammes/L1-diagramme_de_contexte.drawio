        <mxCell id="lg4s" parent="1" style="rounded=1;arcSize=4;html=1;fillColor=none;strokeColor=#8A9199;dashed=1;dashPattern=3 5;verticalAlign=top;align=center;fontSize=10;fontColor=#5F6368;spacingTop=6;spacingLeft=10;spacingRight=10;" value="" vertex="1">
