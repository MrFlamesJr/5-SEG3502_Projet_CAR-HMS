        <mxCell id="lge6t" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;" value="Flux de données entre l&#39;environnement et le système." vertex="1">
          <mxGeometry height="22" width="430" x="138" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="lge6b" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1A1A;" value="La flèche part de celui qui amorce l&#39;échange." vertex="1">
          <mxGeometry height="20" width="430" x="138" y="1516" as="geometry" />
        </mxCell>
        <mxCell id="lge8" edge="1" parent="1" style="edgeStyle=none;html=1;rounded=0;strokeColor=#44474A;strokeWidth=1.4;fontSize=10;fontColor=#1457D6;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=blockThin;endFill=1;endSize=7;align=left;verticalAlign=middle;dashed=1;dashPattern=8 4;" value="">
          <mxGeometry relative="1" as="geometry">
