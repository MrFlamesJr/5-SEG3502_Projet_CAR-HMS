        <mxCell id="navbox" parent="1" style="rounded=1;arcSize=4;html=1;fillColor=none;strokeColor=#8A9199;dashed=1;dashPattern=3 5;verticalAlign=top;align=center;fontSize=10;fontColor=#5F6368;spacingTop=6;spacingLeft=10;spacingRight=10;" value="&lt;i&gt;Tous u&lt;/i&gt;&lt;i style=&quot;background-color: transparent; color: light-dark(rgb(95, 99, 104), rgb(150, 153, 157));&quot;&gt;tilisateurs&lt;/i&gt;" vertex="1">
