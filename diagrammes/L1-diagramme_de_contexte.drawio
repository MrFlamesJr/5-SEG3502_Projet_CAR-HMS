        <mxCell id="regbox" parent="1" style="rounded=1;arcSize=4;html=1;fillColor=none;strokeColor=#8A9199;dashed=1;dashPattern=3 5;verticalAlign=top;align=center;fontSize=10;fontColor=#5F6368;spacingTop=6;spacingLeft=10;spacingRight=10;" value="&lt;i&gt;Utilisateurs enregistrés : authentification et autorisation&lt;br&gt;requises (section 2.2)&lt;/i&gt;" vertex="1">
          <mxGeometry height="626" width="490" x="380" y="359" as="geometry" />
